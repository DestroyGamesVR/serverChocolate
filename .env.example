cd ~/serverChocolate

D1=$(grep -oE '"database_id": *"[^"]+"' ~/ids.txt | head -1 | cut -d'"' -f4)
KV1=$(grep -A2 'RECFLARE_MATCH_PRESENCE"' ~/ids.txt | grep -oE '"id": *"[^"]+"' | head -1 | cut -d'"' -f4)
KV2=$(grep -A2 'RECFLARE_PLAYER_SETTINGS"' ~/ids.txt | grep -oE '"id": *"[^"]+"' | head -1 | cut -d'"' -f4)

echo "D1:  $D1"
echo "KV1: $KV1"
echo "KV2: $KV2"

cat > .env << EOF
RECFLARE_DOMAIN=chocolaterr.destroygames.com

RECFLARE_D1=$D1
RECFLARE_KV='{"RECFLARE_MATCH_PRESENCE":"$KV1","RECFLARE_PLAYER_SETTINGS":"$KV2"}'
RECFLARE_SECRETS_STORE=1d82b247d4f0429081c14cb2bcadd426

RECFLARE_PHOTON_REALTIME_APP_ID=883e05ce-eb94-4235-be09-be3aaf30ce23
RECFLARE_PHOTON_CHAT_APP_ID=88815da8-126f-47a0-8898-0740aa4ea6f3
RECFLARE_PHOTON_VOICE_APP_ID=aa081175-12a9-49b4-a4f2-8599b68ed1e3
RECFLARE_PHOTON_REGION=us

RECFLARE_SUPPORTED_GAME_VERSIONS=20230414,20250718,20260323
RECFLARE_ROLLOUT_GAME_VERSIONS=off

RECFLARE_MAX_UPLOAD_BYTES=10485760
RECFLARE_MAX_API_UPLOAD_BYTES=10485760
EOF

echo "=== .env written ==="
